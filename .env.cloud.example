# Copy this to .env.cloud locally, or add the same keys in your cloud dashboard.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_RESULTS_EMAIL=abhiv@esportscounty.com
DISCORD_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=

# Keep this stable. Changing it logs everyone out.
EC_WEB_SECRET=change-this-to-a-long-random-secret
EC_DATA_DIR=/data
PORT=8080

# API automation. 127.0.0.1 only works if the PUBG observer API runs on the same cloud machine.
OBSERVER_API_URL=http://127.0.0.1:10086/gettotalplayerlist
OBSERVER_POLL_SECONDS=3


