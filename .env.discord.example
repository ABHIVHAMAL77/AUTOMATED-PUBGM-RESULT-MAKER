# Private Discord bot setup for local testing.
# Copy this to .env.discord or run setup_discord_env.bat.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_RESULTS_EMAIL=abhiv@esportscounty.com

# Optional but recommended for instant slash command sync in your server.
# Enable Discord Developer Mode, right-click your server, then Copy Server ID.
DISCORD_GUILD_ID=

# Optional channel for auto-save announcements.
# Right-click a Discord channel, then Copy Channel ID.
DISCORD_ANNOUNCE_CHANNEL_ID=

# API automation. 127.0.0.1 means this computer/cloud machine.
OBSERVER_API_URL=http://127.0.0.1:10086/gettotalplayerlist
OBSERVER_POLL_SECONDS=3
