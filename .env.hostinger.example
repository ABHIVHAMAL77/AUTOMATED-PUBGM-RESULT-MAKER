# Public website domain for this app.
# For your setup, use: result.esportscounty.com
DOMAIN_NAME=result.esportscounty.com

# Discord bot. Keep private.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_RESULTS_EMAIL=abhiv@esportscounty.com
DISCORD_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=

# Website security. Keep stable after launch, or users will be logged out.
EC_WEB_SECRET=change-this-to-a-long-random-secret
EC_DATA_DIR=/data
PORT=8080

# Live match automation.
# In cloud, 127.0.0.1 means the Hostinger VPS, not your game PC.
OBSERVER_API_URL=http://127.0.0.1:10086/gettotalplayerlist
OBSERVER_POLL_SECONDS=3
